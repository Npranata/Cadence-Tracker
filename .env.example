# ==============================================================================
# Cadence Tracker - IBM SSO & OIDC Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Authentication Mode
# Set to 'true' for local development mock SSO, or 'false' for live IBM OIDC SSO
DEV_MOCK_AUTH=true

# IBM OpenID Connect (OIDC) / IBM Cloud App ID / IBM w3id SSO Configuration
# Fill these in when deploying to production with live IBM SSO:
OIDC_CLIENT_ID=your_ibm_oidc_client_id_here
OIDC_CLIENT_SECRET=your_ibm_oidc_client_secret_here
OIDC_DISCOVERY_URL=https://iam.cloud.ibm.com/identity/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
SESSION_SECRET_KEY=generate_a_random_secure_hex_key_for_cookie_signing

# App Settings
APP_NAME=Cadence Tracker (IBM RevOps)
ALLOWED_EMAIL_DOMAINS=ibm.com,kyndryl.com,redhat.com
